# Copy to .env (gitignored). Placeholders only: never commit real values. Variables already set in your shell win over this file.
# --- LLM providers (free tiers only, D15) ---
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
# Other OpenAI-compatible endpoints: NAME_BASE_URL, NAME_API_KEY, NAME_MODEL (optional NAME_AUTH=api-key, NAME_QUERY=api-version=...)
OLLAMA_MODEL=
OLLAMA_HOST=
# Fallback order for the live interviewer, e.g. groq:openai/gpt-oss-20b,gemini:gemini-3.5-flash-lite,ollama:llama3.2:3b
LLM_CHAIN=
# Global ceiling on counted provider calls per rolling 24 h (default 30) and the share of each model's free daily limit we use (default 0.9)
LLM_DAILY_CALL_CAP=
FREE_TIER_MARGIN=
# --- Azure Speech (voice spike; free F0 tier) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# --- Backend ---
FACULTY_TOKENS=
ACCESS_CODE_PEPPER=
AUDIO_SIGNING_SECRET=
DATABASE_URL=
# Postgres for the test suite (see docs/API.md): postgresql+psycopg://USER@localhost/ai_viva_test
TEST_DATABASE_URL=
